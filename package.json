{
  "name": "satark",
  "type": "module",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @satark/extension dev",
    "build": "pnpm --filter @satark/extension build",
    "zip": "pnpm --filter @satark/extension zip",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "build:site": "pnpm --filter @satark/site build",
    "build:firefox": "pnpm --filter @satark/extension build:firefox",
    "zip:firefox": "pnpm --filter @satark/extension zip:firefox"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
